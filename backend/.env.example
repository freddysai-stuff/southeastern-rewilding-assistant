# Copy this file to .env and fill in a key to upgrade the AI Chat Assistant
# from extractive answers (free, offline, built from /data reference docs)
# to fully generative, conversational answers.
#
# Nothing here is required — the backend runs fine with none of these set.

# Which provider to use. Leave unset to auto-detect from whichever API key
# below is present. Set to "none" to force extractive-only mode even if a
# key is set.
# AI_PROVIDER=openai

# --- OpenAI -------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Server ---------------------------------------------------------------
# PORT=4000
